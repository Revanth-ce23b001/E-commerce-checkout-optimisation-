# Copy to config/database.env and fill in. That file is gitignored; this one is not.
#
# The project expects a PostgreSQL 14+ server. The quickest reproducible setup,
# and the one used for the Phase 2B closeout, is a container:
#
#   docker run -d --name rto-postgres \
#     -e POSTGRES_PASSWORD=<password> -e POSTGRES_DB=checkout_rto \
#     -p 5434:5432 postgres:16-alpine
#
# On Windows, see the README note on Hyper-V reserved ports before picking
# PGPORT — several plausible ports are silently unavailable.
PGHOST=localhost
PGPORT=5434
PGUSER=postgres
PGPASSWORD=
PGDATABASE=checkout_rto
